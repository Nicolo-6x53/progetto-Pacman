            <Ellipse x:Name="pacMan" HorizontalAlignment="Left" Height="40px" Stroke="Black" VerticalAlignment="Top" Width="40px
         " Fill="#FFFFF500" RenderTransformOrigin="-0.918,-8.922" Canvas.Left="380" Canvas.Top="197"/>
            <Rectangle Width="250" Height="30" Canvas.Left="275" Stroke="Black" Canvas.Top="32"  HorizontalAlignment="Center" VerticalAlignment="Top" Fill="#FF322F56" RadiusX="19.999" RadiusY="19.999"/>
            <Rectangle Height="100" Canvas.Left="385" Stroke="#FF322F56" Canvas.Top="47" Width="30" HorizontalAlignment="Center" VerticalAlignment="Top" Fill="#FF322F56" RadiusX="19.999" RadiusY="19.999"/>
        </Canvas>

    </Grid>
</Window>
