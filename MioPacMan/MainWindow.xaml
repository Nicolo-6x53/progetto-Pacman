<Window x:Class="MioPacMan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MioPacMan"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" KeyDown="Window_KeyDown" Background="Black">
    <Grid x:Name="gridMappa" Background="Black" RenderTransformOrigin="0.541,0.531">
        <Canvas x:Name="gameCanvas" Margin="-11,0,0,0">
            <Ellipse x:Name="pacMan" HorizontalAlignment="Left" Height="40px" Stroke="Black" VerticalAlignment="Top" Width="40px
         " Fill="#FFFFF500" RenderTransformOrigin="-0.918,-8.922" Canvas.Left="380" Canvas.Top="197"/>
        </Canvas>

    </Grid>
</Window>
